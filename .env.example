APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the app. On Railway set this to the https deployment URL
# (e.g. https://nutrace-production.up.railway.app) so links generated outside
# a request (emails, queued jobs) are secure as well.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The live site runs on Railway, whose Free / Trial / Hobby plans block
# outbound SMTP altogether - Gmail on port 587 included. Production therefore
# sends the password-reset code through the Resend HTTPS API instead:
#   composer require resend/resend-php
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_...
#   MAIL_FROM_ADDRESS="onboarding@resend.dev"   (shared sender, until a domain is verified)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Signed asset QR codes ──────────────────────────────────────────────────
# Every sticker carries a sealed, signed payload: NUT2-<key id>-<body>-<signature>,
# where the body is the asset code encrypted with QR_PAYLOAD_KEY below. Nothing
# readable is printed on the paper; older NUT1 stickers (code in the open) still
# verify and are reported as such.
#
# The secret half of the key lives only in this variable (Railway → Variables in
# the live deployment) and never in a payload, a page, a response, the database
# or the repository. Generate one with:
#     php artisan qr:keygen
# then paste the two lines it prints. To rotate later, keep the retired key in
# the list as <id>:<algorithm>-public:<public key>: it stops signing but still
# verifies the stickers already printed with it. With no key set, stickers carry
# a plain asset code and scans report "verification unavailable" - never fake.
QR_SIGNING_ALGORITHM=auto
QR_SIGNING_ACTIVE_KEY_ID=
QR_SIGNING_KEYS=

# The key that seals the asset code into a sticker body (AES-256-GCM). Use the
# same value on every install that must read the same stickers - your laptop and
# Railway, for example - or one cannot open the other's payloads and those scans
# report "verification unavailable". Generate one with:
#     php artisan qr:keygen --payload
# Left empty, it is derived from APP_KEY, which ties stickers to that one app key.
QR_PAYLOAD_KEY=

# Whether a scan must find the official NU Trace logo in the middle of the QR
# code. With this on, a code recreated on a QR-generator website - the same
# payload, none of the artwork - is refused before any asset is looked up.
# Stickers printed before the logo existed cannot pass that check, so this is
# turned off (false) only while the office reprints its labels. Default: true.
QR_REQUIRE_SEAL=true

# Minutes within which the same sticker seen from a different account or network
# is flagged as a possible copy. This warns; it never blocks a scan.
QR_DUPLICATE_WINDOW_MINUTES=30

# The phone's resolver (/qr/resolve) is credentialed: the app exchanges the
# account's email and password once at /qr/session for a signed, expiring token.
# These control that token and the limits on both routes. Defaults: a 30-day
# token, 60 resolutions per account per minute (2,000/day), and 10 sign-in
# attempts per email+address per minute.
#
# QR_LIMITER_STORE names a cache store, not a database table. The app's default
# cache store is `database`, and this deployment has no `cache` table, so the
# limiter uses `file` (storage/framework/cache). Set it to `redis` if one is
# ever added; leave it as `file` otherwise.
QR_LIMITER_STORE=file
# QR_MOBILE_TOKEN_DAYS=30
# QR_RESOLVE_PER_MINUTE=60
# QR_RESOLVE_PER_DAY=2000
# QR_MOBILE_LOGIN_PER_MINUTE=10

# ── Executive Director transfer review ─────────────────────────────────────
# The Executive Director has no NU Trace account. A transfer request the office
# approves can be forwarded to them instead of being carried out immediately:
# they receive one emailed link, prove they hold the inbox it reached by typing
# a 6-digit code sent to that same inbox, decide on that one transfer (all of
# it, some of it, or none of it with a reason), and the link stops working.
# Nothing changes hands until a decision is submitted, and a transfer approved
# in part reassigns only the assets that were approved.
#
# Who gets asked is the Asset Management Office's answer, not this file's: the
# office types the Executive Director's address when it forwards a transfer, and
# the invitation, the link and the verification code go to the address it typed
# and nowhere else. Nobody can redirect an invitation by tampering with a
# request. That is deliberate - a change of Executive Director is a change of
# text on a form, not a deployment.
#
# TRANSFER_REVIEW_EMAIL is optional convenience only: when it is set, the approve
# dialog starts with this address already filled in and a plain re-send goes back
# to whoever received the last invitation. Leave it empty and the office types
# the address every time; nothing else changes.
#
# TRANSFER_REVIEW_NAME is optional too. Left empty, the emails open "Dear
# Executive Director" rather than a name that would be the previous director's
# the day after the appointment changes.
#
# TRANSFER_REVIEW_OFFICE_EMAIL is where the review pages tell the reader to write
# when a link cannot be used. It falls back to the address above, then to
# MAIL_FROM_ADDRESS, and to no address at all if none is set.
#
# The invitation and the code use whichever MAIL_MAILER above is configured - on
# the live deployment that is Resend.
TRANSFER_REVIEW_EMAIL=
TRANSFER_REVIEW_OFFICE_EMAIL=
TRANSFER_REVIEW_NAME=
# How long a review link stays usable (default 168 hours = one week).
TRANSFER_REVIEW_LINK_TTL_HOURS=168
# Verification code lifetime, attempts allowed per code, codes allowed per
# window, length of that window, and the pause between two code requests.
TRANSFER_REVIEW_CODE_TTL_MINUTES=15
TRANSFER_REVIEW_CODE_ATTEMPTS=5
TRANSFER_REVIEW_CODE_REQUESTS=3
TRANSFER_REVIEW_CODE_WINDOW_MINUTES=60
TRANSFER_REVIEW_CODE_COOLDOWN=60
# How long a browser stays verified after entering a code (default 4 hours).
TRANSFER_REVIEW_SESSION_HOURS=4
# Whether the approve dialog offers forwarding with the box already ticked.
TRANSFER_REVIEW_FORWARD_BY_DEFAULT=true

# Disposal service-life review. The mark is ADVISORY: it files assets at the
# Disposal page's review tab, it never approves a disposal or changes a status.
# Keep the proposed 3 until the Asset Management Office confirms the policy.
DISPOSAL_AGE_REVIEW_ENABLED=true
DISPOSAL_AGE_REVIEW_YEARS=3

# Waiting period, in years, between approving a disposal request and being
# allowed to finalize it. Preparation, printing and signing the official form
# are not delayed; only final disposal is.
DISPOSAL_HOLD_YEARS=3

# Supabase Storage: profile photos, asset photos, request attachments and QR images.
# When SUPABASE_URL and a key are set, the public disk is served from Supabase Storage.
# SUPABASE_SERVICE_ROLE_KEY is required in production: a bucket marked PUBLIC only
# allows anonymous READS, so uploads with the anon key are refused by row level
# security and every asset ends up showing "No image".
# Check the live deployment with: php artisan media:doctor
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=assets

# Existing asset import (Admin → Assets → Import Inventory).
# The workbook is streamed in windows, so the row counts below are the size of
# one request, not a limit on the file. The upload itself has no size limit: the
# page sends the file in slices of ASSET_IMPORT_PART_MB, which is capped to PHP's
# own upload_max_filesize / post_max_size automatically, so a 1 GB workbook needs
# no php.ini change. (ASSET_IMPORT_MAX_MB is no longer read.)
# ASSET_IMPORT_PART_MB=8
# ASSET_IMPORT_CHECK_ROWS=400
# ASSET_IMPORT_CHECK_SECONDS=8
# ASSET_IMPORT_IMPORT_ROWS=100
# ASSET_IMPORT_IMPORT_SECONDS=12

# Printed asset sticker, in millimetres. These must match the media size set in
# the printer driver (Zebra ZD230: 1.969" x 0.984" = 50 x 25 mm); a larger
# driver size makes the browser shrink the sticker and the QR stops scanning.
# Leave them unset to use the defaults in config/asset_label.php.
# ASSET_LABEL_WIDTH_MM=50
# ASSET_LABEL_HEIGHT_MM=25
# ASSET_LABEL_INSET_MM=1
# ASSET_LABEL_QR_MM=21

VITE_APP_NAME="${APP_NAME}"
